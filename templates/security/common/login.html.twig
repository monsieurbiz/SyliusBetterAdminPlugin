{% import '@SyliusUi/Macro/messages.html.twig' as messages %}

{% set logo = setting('monsieurbiz_better_admin.admin', 'logo')|default('') %}
{% set backgroundImage = setting('monsieurbiz_better_admin.admin', 'background_image')|default('') %}
{% set form = form|default(null) %}
{% set last_error = last_error|default(null) %}
{% set last_username = last_username|default('') %}

{% hook 'sylius.admin.login.before_page' %}

<div class="login-container">
    <div class="login-box">
        {% hook 'sylius.admin.login.before_content' %}
        
        {% if form is not null %}
            {% hook 'sylius.admin.login.before_form' with {'form': form} %}
        {% endif %}

        {% if last_error %}
            <div class="login-error">
                {{ messages.error(last_error.messageKey) }}
            </div>
        {% endif %}

        {% if form is not null %}
            {{ form_start(form, {'action': action|default('/'), 'attr': {'class': 'login-form', 'novalidate': 'novalidate'}}) }}
        {% endif %}
        
        <div class="login-content">
            {% hook 'sylius_admin.security.login.page.logo' with {'paths': paths|default({})} %}
            
            {% hook 'sylius.admin.login.form.before_fields' with {'form': form} %}
            
            {% hook 'sylius.admin.login.form.content' %}
            
            {% hook 'sylius.admin.login.form.after_fields' with {'form': form} %}
        </div>

        {% if form is not null %}
            {% hook 'sylius.admin.login.after_form' with {'form': form} %}
            {{ form_end(form, {'render_rest': false}) }}
        {% endif %}
        
        {% hook 'sylius.admin.login.after_content' %}
    </div>
</div>

{% hook 'sylius.admin.login.after_page' %}


<script type="text/javascript">
    function changeBodyBackground(imgUrl)
    {
        let bodyStyle = document.body.style;
        bodyStyle.backgroundSize = 'cover';
        bodyStyle.backgroundRepeat = 'no-repeat';
        bodyStyle.backgroundImage = "url('" + imgUrl + "')";
    }

    document.addEventListener('DOMContentLoaded', function() {
        {% if backgroundImage is empty %}
        changeBodyBackground('https://picsum.photos/1600/900?random');
        {% else %}
        changeBodyBackground('{{ asset(backgroundImage) | imagine_filter('admin_login_background') | escape('js') }}');
        {% endif %}
    });
</script>
